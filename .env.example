# Copy to .env (local) or set in Vercel -> Project Settings -> Environment Variables. NEVER commit real values.

# PostgreSQL connection string. Default port is 5432. Put the real password only in Vercel/.env, never in Git.
DATABASE_URL="postgresql://USERNAME:PASSWORD@HOST:5432/DATABASE_NAME?sslmode=require"
# Optional: max pooled connections per server instance (default 5)
DATABASE_POOL_MAX="5"

# 32-byte key for AES-256-GCM image encryption (required for the "db" storage driver).
# Generate with:  openssl rand -hex 32     — keep it secret and never change it without re-encrypting stored images.
IMAGE_ENCRYPTION_KEY="64-hex-characters-from-openssl-rand-hex-32"

# Media storage driver: "db" (encrypted PostgreSQL; default in production), "local" (dev disk), or "r2".
STORAGE_DRIVER="db"
# Only for STORAGE_DRIVER=local
STORAGE_LOCAL_DIR="./.media"
STORAGE_PUBLIC_BASE=""

# Only for STORAGE_DRIVER=r2
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET_MEDIA=""
R2_BUCKET_IMPORTS=""
R2_PUBLIC_BASE_URL=""

# Public (non-secret) base URL for media links; leave empty to use same-origin /media
NEXT_PUBLIC_MEDIA_BASE_URL=""

AUTH_SECRET="generate-with: openssl rand -hex 32"
AUTH_URL="https://your-domain.example"
