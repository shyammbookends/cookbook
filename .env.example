# Copy to .env (local) or set in Vercel -> Project Settings -> Environment Variables. NEVER commit real values.

# PostgreSQL connection string used by the app at runtime. Put the real password only in Vercel/.env, never in Git.
# Local dev:  postgresql://USERNAME:PASSWORD@127.0.0.1:5432/DATABASE_NAME
# Supabase (Vercel): the TRANSACTION pooler, port 6543 (Supabase > Connect > Transaction pooler), e.g.
#   postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres?sslmode=require&uselibpqcompat=true
#   (uselibpqcompat=true: encrypted connection without failing on Supabase's own CA certificate)
DATABASE_URL="postgresql://USERNAME:PASSWORD@HOST:5432/DATABASE_NAME"
# Only needed when running migrations against Supabase: the SESSION pooler (or direct) URL, port 5432.
# Leave unset for local dev (migrations then use DATABASE_URL). Not needed in Vercel.
DIRECT_URL=""
# Optional: max pooled connections per server instance (default 5). Keep 5 on Vercel: images and pages share it concurrently.
DATABASE_POOL_MAX="5"

# 32-byte key for AES-256-GCM image encryption (required for the "supabase" and "db" storage drivers).
# Generate with:  openssl rand -hex 32     — keep it secret and never change it without re-encrypting stored images.
IMAGE_ENCRYPTION_KEY="64-hex-characters-from-openssl-rand-hex-32"

# Media storage driver: "supabase" (encrypted files in a private Supabase Storage bucket — use this on Vercel),
# "db" (encrypted in PostgreSQL; default in production if unset), "local" (dev disk), or "r2".
STORAGE_DRIVER="supabase"

# Only for STORAGE_DRIVER=supabase (Supabase > Storage > S3). The access keys are SECRET — Vercel/.env only.
SUPABASE_STORAGE_BUCKET=""
SUPABASE_S3_ENDPOINT="https://PROJECT_REF.storage.supabase.co/storage/v1/s3"
SUPABASE_S3_REGION=""
SUPABASE_S3_ACCESS_KEY_ID=""
SUPABASE_S3_SECRET_ACCESS_KEY=""
# Only for STORAGE_DRIVER=local
STORAGE_LOCAL_DIR="./.media"
STORAGE_PUBLIC_BASE=""

# Only for STORAGE_DRIVER=r2
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET_MEDIA=""
R2_BUCKET_IMPORTS=""
R2_PUBLIC_BASE_URL=""

# Leave EMPTY (do not set it in Vercel). Image keys already start with "media/", so "/media" here
# produces broken /media/media/... URLs.
NEXT_PUBLIC_MEDIA_BASE_URL=""

# Currently not read by the code (sessions are random tokens stored in the DB); safe to set anyway.
AUTH_SECRET="generate-with: openssl rand -hex 32"
# Public site URL (used for canonical links, sitemap, robots, share links). Production: https://your-domain
AUTH_URL="https://your-domain.example"

# ── One-time local → Supabase copy (backend/scripts/migrate-to-supabase.ts) ──
# Put these in .env.supabase (git-ignored), NOT in .env:
#   SOURCE_DATABASE_URL   local database URL
#   TARGET_DATABASE_URL   Supabase session pooler / direct URL (port 5432)
#   IMAGE_ENCRYPTION_KEY  the same value as in Vercel
#   DIRECT_URL            same as TARGET_DATABASE_URL (for prisma migrate deploy)
