{
  "name": "recipe",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev ./frontend",
    "build": "prisma generate --schema=backend/prisma/schema.prisma && next build ./frontend",
    "start": "next start ./frontend",
    "lint": "eslint",
    "db:deploy": "prisma migrate deploy --config=backend/prisma.config.ts",
    "db:migrate": "prisma migrate dev --schema=backend/prisma/schema.prisma",
    "db:generate": "prisma generate --schema=backend/prisma/schema.prisma",
    "db:seed": "tsx backend/prisma/seed.ts",
    "db:studio": "prisma studio --schema=backend/prisma/schema.prisma",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "prisma": {
    "schema": "backend/prisma/schema.prisma"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1136.0",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@hookform/resolvers": "^5.9.1",
    "@node-rs/argon2": "^2.2.1",
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "@react-three/drei": "^10.7.8",
    "@react-three/fiber": "^9.7.0",
    "clsx": "^2.1.1",
    "exceljs": "^4.4.0",
    "file-type": "^22.1.1",
    "jszip": "^3.10.2",
    "lenis": "^1.3.26",
    "marked": "^18.0.13",
    "motion": "^13.4.0",
    "next": "16.3.5",
    "pg": "^8.23.0",
    "pg-boss": "^12.33.3",
    "pino": "^10.3.1",
    "prisma": "^7.10.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-hook-form": "^7.88.0",
    "sanitize-html": "^2.17.7",
    "server-only": "^0.0.1",
    "sharp": "^0.35.4",
    "slugify": "^1.6.9",
    "three": "^0.186.0",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^24.13.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/sanitize-html": "^2.16.1",
    "@types/three": "^0.186.0",
    "concurrently": "^10.0.5",
    "dotenv": "^18.0.1",
    "eslint": "^9",
    "eslint-config-next": "16.3.5",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^5.0.1"
  }
}
